module image_processor_parallel #(parameter int ROWS = 256,
                                  parameter int COLS = 256,
                                  parameter int TOTAL_PIXELS = ROWS * COLS)

                                 (input  logic clk,
                                  input  logic reset,
                                  input  logic start,
                                  output logic done);

    // input and output image memories
    logic [7:0] input_memory  [0:TOTAL_PIXELS-1];
    logic [7:0] output_memory [0:TOTAL_PIXELS-1];

    // pixel counter
    logic [$clog2(TOTAL_PIXELS):0] pixel_index;

    // temporary brightness values
    logic [8:0] bright0;
    logic [8:0] bright1;
    logic [8:0] bright2;
    logic [8:0] bright3;

    // cycle counter
    logic [31:0] cycle_count;

    initial begin
        $readmemh("image_input.txt", input_memory);
    end

    always_ff @(posedge clk or posedge reset) begin
        if (reset) begin
            pixel_index <= 0;
            done        <= 0;
            cycle_count <= 0;
        end else begin
            if (start && !done) begin

                // increment cycle counter every clock
                cycle_count <= cycle_count + 1;

                // pixel 0
                bright0 = input_memory[pixel_index] + 9'd40;

                if (bright0 > 9'd255)
                    output_memory[pixel_index] <= 8'd255;
                else
                    output_memory[pixel_index] <= bright0[7:0];

                // pixel 1
                if (pixel_index + 1 < TOTAL_PIXELS) begin
                    bright1 = input_memory[pixel_index + 1] + 9'd40;

                    if (bright1 > 9'd255)
                        output_memory[pixel_index + 1] <= 8'd255;
                    else
                        output_memory[pixel_index + 1] <= bright1[7:0];
                end

                // pixel 2
                if (pixel_index + 2 < TOTAL_PIXELS) begin
                    bright2 = input_memory[pixel_index + 2] + 9'd40;

                    if (bright2 > 9'd255)
                        output_memory[pixel_index + 2] <= 8'd255;
                    else
                        output_memory[pixel_index + 2] <= bright2[7:0];
                end

                // pixel 3
                if (pixel_index + 3 < TOTAL_PIXELS) begin
                    bright3 = input_memory[pixel_index + 3] + 9'd40;

                    if (bright3 > 9'd255)
                        output_memory[pixel_index + 3] <= 8'd255;
                    else
                        output_memory[pixel_index + 3] <= bright3[7:0];
                end

                // move by 4 pixels instead of 1
                if (pixel_index + 4 >= TOTAL_PIXELS) begin
                    done <= 1;
                end else begin
                    pixel_index <= pixel_index + 4;
                end
            end
        end
    end

endmodule 
