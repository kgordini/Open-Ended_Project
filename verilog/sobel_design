module image_processor_sobel #(parameter int ROWS = 256,
                               parameter int COLS = 256,
                               parameter int TOTAL_PIXELS = ROWS * COLS)

                              (input  logic clk,
                               input  logic reset,
                               input  logic start,
                               output logic done);

    // input and output image memories
    logic [7:0] input_memory  [0:TOTAL_PIXELS-1];
    logic [7:0] output_memory [0:TOTAL_PIXELS-1];

    // pixel counter
    logic [$clog2(TOTAL_PIXELS):0] pixel_index;

    // cycle counter
    logic [31:0] cycle_count;

    int row;
    int col;

    int p00, p01, p02;
    int p10,      p12;
    int p20, p21, p22;

    int gx;
    int gy;
    int edge_value;

    initial begin
        $readmemh("image_input.txt", input_memory);
    end

    always_ff @(posedge clk or posedge reset) begin
        if (reset) begin
            pixel_index <= 0;
            done        <= 0;
            cycle_count <= 0;
        end else begin
            if (start && !done) begin

                // increment cycle counter every clock
                cycle_count <= cycle_count + 1;

                row = pixel_index / COLS;
                col = pixel_index % COLS;

                // border pixels are set to black
                if (row == 0 || row == ROWS-1 || col == 0 || col == COLS-1) begin
                    output_memory[pixel_index] <= 8'd0;
                end else begin

                    // 3x3 pixel window
                    p00 = input_memory[(row-1)*COLS + (col-1)];
                    p01 = input_memory[(row-1)*COLS + col];
                    p02 = input_memory[(row-1)*COLS + (col+1)];

                    p10 = input_memory[row*COLS + (col-1)];
                    p12 = input_memory[row*COLS + (col+1)];

                    p20 = input_memory[(row+1)*COLS + (col-1)];
                    p21 = input_memory[(row+1)*COLS + col];
                    p22 = input_memory[(row+1)*COLS + (col+1)];

                    // sobel kernels
                    gx = -p00 + p02 - (2*p10) + (2*p12) - p20 + p22;
                    gy = -p00 - (2*p01) - p02 + p20 + (2*p21) + p22;

                    // absolute values
                    if (gx < 0)
                        gx = -gx;

                    if (gy < 0)
                        gy = -gy;

                    // approximate magnitude
                    edge_value = gx + gy;

                    // clamp to 8-bit
                    if (edge_value > 255)
                        output_memory[pixel_index] <= 8'd255;
                    else
                        output_memory[pixel_index] <= edge_value[7:0];
                end

                if (pixel_index == TOTAL_PIXELS - 1) begin
                    done <= 1;
                end else begin
                    pixel_index <= pixel_index + 1;
                end
            end
        end
    end

endmodule
