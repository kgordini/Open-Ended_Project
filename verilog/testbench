`timescale 1ns/1ps

module testbench_image_processor;

    parameter int ROWS = 256;
    parameter int COLS = 256;
    parameter int TOTAL_PIXELS = ROWS * COLS;

    logic clk;
    logic reset;
    logic start;

    logic done_seq;
    logic done_parallel;
    logic done_sobel;

    integer file_seq;
    integer file_parallel;
    integer file_sobel;
    integer i;

    // sequential brightness processor
    image_processor #(
        .ROWS(ROWS),
        .COLS(COLS),
        .TOTAL_PIXELS(TOTAL_PIXELS))
    dut_seq (
        .clk(clk),
        .reset(reset),
        .start(start),
        .done(done_seq));

    // parallel brightness processor
    image_processor_parallel #(
        .ROWS(ROWS),
        .COLS(COLS),
        .TOTAL_PIXELS(TOTAL_PIXELS))
    dut_parallel (
        .clk(clk),
        .reset(reset),
        .start(start),
        .done(done_parallel));

    // sobel edge detector
    image_processor_sobel #(
        .ROWS(ROWS),
        .COLS(COLS),
        .TOTAL_PIXELS(TOTAL_PIXELS))
    dut_sobel (
        .clk(clk),
        .reset(reset),
        .start(start),
        .done(done_sobel));

    // clock
    always #5 clk = ~clk;

    initial begin
        clk   = 0;
        reset = 1;
        start = 0;

        #20;
        reset = 0;

        #10;
        start = 1;

        // wait until all designs finish
        wait(done_seq == 1 && done_parallel == 1 && done_sobel == 1);

        #20;

        // sequential output
        file_seq = $fopen("image_output_sequential.txt", "w");
        for (i = 0; i < TOTAL_PIXELS; i = i + 1) begin
            $fwrite(file_seq, "%02X\n", dut_seq.output_memory[i]);
        end
        $fclose(file_seq);

        // parallel output
        file_parallel = $fopen("image_output_parallel.txt", "w");
        for (i = 0; i < TOTAL_PIXELS; i = i + 1) begin
            $fwrite(file_parallel, "%02X\n", dut_parallel.output_memory[i]);
        end
        $fclose(file_parallel);

        // sobel output
        file_sobel = $fopen("image_output_sobel.txt", "w");
        for (i = 0; i < TOTAL_PIXELS; i = i + 1) begin
            $fwrite(file_sobel, "%02X\n", dut_sobel.output_memory[i]);
        end
        $fclose(file_sobel);

        $display("Sequential output created: image_output_sequential.txt");
        $display("Parallel output created: image_output_parallel.txt");
        $display("Sobel output created: image_output_sobel.txt");

        // cycle count results
        $display("Sequential cycles = %0d", dut_seq.cycle_count);
        $display("Parallel cycles   = %0d", dut_parallel.cycle_count);
        $display("Sobel cycles      = %0d", dut_sobel.cycle_count);

        #20;
        $stop;
    end

endmodule
